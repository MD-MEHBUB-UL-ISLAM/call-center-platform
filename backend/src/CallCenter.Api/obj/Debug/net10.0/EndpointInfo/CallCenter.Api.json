  "components": {
    "schemas": {
      "AgentDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "email": {
            "type": "string",
            "nullable": true
          },
          "role": {
            "$ref": "#/components/schemas/UserRole"
          },
          "status": {
            "$ref": "#/components/schemas/AgentStatus"
          },
          "queueName": {
            "type": "string",
            "nullable": true
          },
          "skills": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "AgentStatus": {
        "enum": [
          "Offline",
          "Available",
          "OnCall",
          "Busy",
          "OnBreak"
        ],
        "type": "string"
      },
      "CallDirection": {
        "enum": [
          "Inbound",
          "Outbound"
        ],
        "type": "string"
      },
      "CallDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "correlationId": {
            "type": "string",
            "format": "uuid"
          },
          "direction": {
            "$ref": "#/components/schemas/CallDirection"
          },
          "status": {
            "$ref": "#/components/schemas/CallStatus"
          },
          "fromNumber": {
            "type": "string",
            "nullable": true
          },
          "toNumber": {
            "type": "string",
            "nullable": true
          },
          "agentId": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "agentName": {
            "type": "string",
            "nullable": true
          },
          "queueName": {
            "type": "string",
            "nullable": true
          },
          "crmContactId": {
            "type": "string",
            "nullable": true
          },
          "crmContactName": {
            "type": "string",
            "nullable": true
          },
          "queuedAtUtc": {
            "type": "string",
            "format": "date-time"
          },
          "connectedAtUtc": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "endedAtUtc": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "dispositionCode": {
            "type": "string",
            "nullable": true
          },
          "notes": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CallStatus": {
        "enum": [
          "Queued",
          "Ringing",
          "Connected",
          "OnHold",
          "Completed",
          "Abandoned"
        ],
        "type": "string"
      },
      "EndCallRequest": {
        "type": "object",
        "properties": {
          "dispositionCode": {
            "type": "string",
            "nullable": true
          },
          "notes": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "nullable": true
          },
          "password": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "nullable": true
          },
          "agent": {
            "$ref": "#/components/schemas/AgentDto"
          }
        },
        "additionalProperties": false
      },
      "PlaceOutboundCallRequest": {
        "type": "object",
        "properties": {
          "toNumber": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "SimulateInboundCallRequest": {
        "type": "object",
        "properties": {
          "fromNumber": {
            "type": "string",
            "nullable": true
          },
          "toNumber": {
            "type": "string",
            "nullable": true
          },
          "queueName": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "UpdateAgentStatusRequest": {
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/AgentStatus"
          }
        },
        "additionalProperties": false
      },
      "UserRole": {
        "enum": [
          "Agent",
          "Supervisor",
          "Admin"
        ],
        "type": "string"
      }
    }
  }
}