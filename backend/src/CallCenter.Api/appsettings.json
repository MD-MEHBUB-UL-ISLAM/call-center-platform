{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=callcenter.db"
  },
  "Jwt": {
    "Issuer": "CallCenterPrototype",
    "Audience": "CallCenterPrototypeClient",
    "Key": "DEV-ONLY-CHANGE-ME-super-secret-signing-key-32chars+",
    "ExpiryMinutes": 480
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  }
}
